{
  "name": "agentmbx",
  "version": "0.4.0",
  "description": "AgentMBX: signed messages between AI coding agents (Claude, Codex, Kimi, OpenCode, Hermes) on one machine and across a LAN, with wake-up adapters and an owner-authority master agent.",
  "type": "module",
  "bin": {
    "agentmbx": "bin/agentmbx.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "AGENTMBX_DEV=1 node --test --test-concurrency=1 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:macos": "bash scripts/build-macos-app.sh",
    "check-dist": "npm run build && git diff --exit-code -- dist",
    "build:sea": "node scripts/build-sea.mjs",
    "smoke:sea": "node scripts/smoke-sea.mjs"
  },
  "license": "BUSL-1.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "multicast-dns": "^7.2.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2"
  },
  "homepage": "https://agentmbx.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kryptobaseddev/agentmbx.git"
  },
  "bugs": {
    "url": "https://github.com/kryptobaseddev/agentmbx/issues"
  },
  "author": "Keaton Hoskins",
  "keywords": [
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "opencode",
    "kimi",
    "hermes",
    "agent-messaging",
    "multi-agent"
  ],
  "files": [
    "bin",
    "dist",
    "macos",
    "scripts/build-macos-app.sh",
    "skill",
    "src",
    "docs",
    "LICENSE",
    "README.md",
    "NOTICE"
  ]
}
